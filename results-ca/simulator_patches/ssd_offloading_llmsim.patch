+// ---------------------------------------------------------------------------
+// Synthetic routing models (MoE memory-wall project).
+// Read once from config.yaml -> simulation.routing (all keys optional):
+//   model:      uniform (default, original behaviour) | zipf | correlated
+//   zipf_s:     Zipf exponent of the per-layer expert popularity (0 = uniform)
+//   p_temporal: P(slot j reuses the expert of slot j of the previous token, same layer)
+//   p_spatial:  P(slot j follows pi_l(expert of slot j at layer l-1), same token)
+//   seed:       RNG seed
+//   log_file:   if set, every routing decision is written as
+//               step,layer,seq,token,e_0,...,e_{k-1}
+//
+// model: router  -- mechanistic gating, as in a real MoE layer (Q4-extended):
+//   every token carries a hidden vector h (dimension router_dim) that
+//     * drifts between consecutive tokens of a sequence:
+//         x_t = token_similarity * x_{t-1} + sqrt(1 - token_similarity^2) * noise
+//     * is updated by each layer through the residual stream:
+//         h_0 = x_t,  h_l = rmsnorm(h_{l-1} + layer_update * tanh(A_l h_{l-1}))
+//   and the router of MoE layer l scores every expert and keeps the top-k:
+//         score_l = W_l h_l + b_l       (W_l, A_l, b_l fixed random per layer;
+//                                        b_l ~ N(0, router_bias) creates popular experts)
+//   keys: router_dim (64), token_similarity (0.9), layer_update (0.5), router_bias (0)
+// ---------------------------------------------------------------------------
+namespace {
+struct RoutingConfig {
+  bool loaded = false;
+  std::string model = "uniform";
+  double zipf_s = 0.0, p_temporal = 0.0, p_spatial = 0.0;
+  unsigned seed = 777;
+  std::ofstream log;
+  std::mt19937 gen;
+  std::vector<std::vector<int>> popularity;  // [layer][rank] -> expert id
+  std::vector<std::vector<int>> next_map;    // [layer][expert at l-1] -> expert at l
+  std::map<int, std::vector<std::vector<int>>> prev_token;  // seq -> [layer][slot]
+  std::map<int, std::vector<int>> prev_layer;               // seq -> [slot]
+  // model: router
+  int router_dim = 64;
+  double token_similarity = 0.9, layer_update = 0.5, router_bias = 0.0;
+  std::vector<std::vector<float>> W, A, b;                  // [layer] -> row-major matrices
+  std::map<int, std::pair<int, std::vector<float>>> token_x; // seq -> (token, content x_t)
+  std::map<long long, std::vector<float>> hidden;           // (seq, token) -> h at last layer
+};
+RoutingConfig rcfg;
+long long route_call = 0;
+
+void loadRoutingConfig(int num_layer, int num_expert) {
+  if (rcfg.loaded) return;
+  rcfg.loaded = true;
+  YAML::Node r = YAML::LoadFile("config.yaml")["simulation"]["routing"];
+  if (r) {
+    if (r["model"]) rcfg.model = r["model"].as<std::string>();
+    if (r["zipf_s"]) rcfg.zipf_s = r["zipf_s"].as<double>();
+    if (r["p_temporal"]) rcfg.p_temporal = r["p_temporal"].as<double>();
+    if (r["p_spatial"]) rcfg.p_spatial = r["p_spatial"].as<double>();
+    if (r["seed"]) rcfg.seed = r["seed"].as<unsigned>();
+    if (r["router_dim"]) rcfg.router_dim = r["router_dim"].as<int>();
+    if (r["token_similarity"]) rcfg.token_similarity = r["token_similarity"].as<double>();
+    if (r["layer_update"]) rcfg.layer_update = r["layer_update"].as<double>();
+    if (r["router_bias"]) rcfg.router_bias = r["router_bias"].as<double>();
+    if (r["log_file"]) {
+      rcfg.log.open(r["log_file"].as<std::string>());
+      rcfg.log << "step,layer,seq,token,experts...\n";
+    }
+  }
+  rcfg.gen.seed(rcfg.seed);
+  std::vector<int> ids(num_expert);
+  std::iota(ids.begin(), ids.end(), 0);
+  for (int l = 0; l < num_layer; l++) {
+    std::shuffle(ids.begin(), ids.end(), rcfg.gen);
+    rcfg.popularity.push_back(ids);
+    std::shuffle(ids.begin(), ids.end(), rcfg.gen);
+    rcfg.next_map.push_back(ids);
+  }
+  if (rcfg.model == "router") {
+    const int d = rcfg.router_dim;
+    std::normal_distribution<float> g(0.0f, 1.0f / std::sqrt((float)d));
+    std::normal_distribution<float> gb(0.0f, (float)rcfg.router_bias);
+    for (int l = 0; l < num_layer; l++) {
+      std::vector<float> W(num_expert * d), A(d * d), b(num_expert, 0.0f);
+      for (auto &w : W) w = g(rcfg.gen);
+      for (auto &a : A) a = g(rcfg.gen);
+      if (rcfg.router_bias > 0) for (auto &x : b) x = gb(rcfg.gen);
+      rcfg.W.push_back(W);
+      rcfg.A.push_back(A);
+      rcfg.b.push_back(b);
+    }
+  }
+}
+
+int drawBase(int layer, int num_expert) {
+  if (rcfg.zipf_s <= 0.0) {
+    std::uniform_int_distribution<int> u(0, num_expert - 1);
+    return u(rcfg.gen);
+  }
+  static std::discrete_distribution<int> zipf;
+  static bool init = false;
+  if (!init) {
+    std::vector<double> w(num_expert);
+    for (int i = 0; i < num_expert; i++) w[i] = 1.0 / std::pow(i + 1, rcfg.zipf_s);
+    zipf = std::discrete_distribution<int>(w.begin(), w.end());
+    init = true;
+  }
+  return rcfg.popularity[layer][zipf(rcfg.gen)];
+}
+}  // namespace
+
+std::vector<int> drawRoutedExperts(int seq_id, int layer, int num_layer,
+                                   int num_expert, int top_k) {
+  std::uniform_real_distribution<double> coin(0.0, 1.0);
+  auto &prev_tok = rcfg.prev_token[seq_id];
+  if (prev_tok.empty()) prev_tok.resize(num_layer);
+  auto &prev_lay = rcfg.prev_layer[seq_id];
+  std::vector<int> chosen;
+  for (int j = 0; j < top_k; j++) {
+    int cand = -1;
+    if (rcfg.model == "correlated") {
+      if (!prev_tok[layer].empty() && coin(rcfg.gen) < rcfg.p_temporal) {
+        cand = prev_tok[layer][j];
+      } else if (layer > 0 && !prev_lay.empty() && coin(rcfg.gen) < rcfg.p_spatial) {
+        cand = rcfg.next_map[layer][prev_lay[j]];
+      }
+    }
+    while (cand < 0 || std::find(chosen.begin(), chosen.end(), cand) != chosen.end()) {
+      cand = drawBase(layer, num_expert);
+    }
+    chosen.push_back(cand);
+  }
+  prev_tok[layer] = chosen;
+  prev_lay = chosen;
+  return chosen;
+}
+
+// model: router -- hidden-state gating (see the header comment above)
+std::vector<int> routerExperts(int seq_id, int token_id, int layer, int num_layer,
+                               int num_expert, int top_k) {
+  const int d = rcfg.router_dim;
+  const long long key = (long long)seq_id * 100000000LL + token_id;
+  std::vector<float> h;
+  if (layer == 0) {
+    // token content drifts from the previous token of the same sequence
+    std::normal_distribution<float> n(0.0f, 1.0f);
+    const float rho = (float)rcfg.token_similarity;
+    const float s = std::sqrt(std::max(0.0f, 1.0f - rho * rho));
+    auto it = rcfg.token_x.find(seq_id);
+    bool has_prev = it != rcfg.token_x.end() && it->second.first == token_id - 1;
+    h.resize(d);
+    for (int i = 0; i < d; i++)
+      h[i] = has_prev ? rho * it->second.second[i] + s * n(rcfg.gen) : n(rcfg.gen);
+    rcfg.token_x[seq_id] = {token_id, h};
+  } else {
+    // residual-stream update by this layer, then RMS normalisation
+    const std::vector<float> &prev = rcfg.hidden[key];
+    const std::vector<float> &A = rcfg.A[layer];
+    h.resize(d);
+    double ss = 0.0;
+    for (int i = 0; i < d; i++) {
+      float u = 0.0f;
+      for (int j = 0; j < d; j++) u += A[i * d + j] * prev[j];
+      h[i] = prev[i] + (float)rcfg.layer_update * std::tanh(u);
+      ss += (double)h[i] * h[i];
+    }
+    const float inv = 1.0f / (float)std::sqrt(ss / d + 1e-12);
+    for (auto &x : h) x *= inv;
+  }
+  // router: score every expert, keep the top-k
+  const std::vector<float> &W = rcfg.W[layer];
+  std::vector<std::pair<float, int>> score(num_expert);
+  for (int e = 0; e < num_expert; e++) {
+    float s = rcfg.b[layer][e];
+    for (int i = 0; i < d; i++) s += W[e * d + i] * h[i];
+    score[e] = {s, e};
+  }
+  std::partial_sort(score.begin(), score.begin() + top_k, score.end(),
+                    [](const std::pair<float, int> &a, const std::pair<float, int> &b) {
+                      return a.first > b.first;
+                    });
+  std::vector<int> chosen;
+  for (int j = 0; j < top_k; j++) chosen.push_back(score[j].second);
+  if (layer == num_layer - 1) rcfg.hidden.erase(key);
+  else rcfg.hidden[key] = h;
+  return chosen;
+}
